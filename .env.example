MUIRO_ADMIN_PIN=
# MUIRO backend configuration (self-hosted; no Google AI Studio / Gemini key required).

# PORT: port the Express + Vite dev server listens on. Defaults to 3000.
PORT=3000

# HOST: interface to bind. Defaults to 0.0.0.0.
HOST=0.0.0.0

# STRICT_PORT: when true, exit instead of falling back to another port if PORT is busy.
STRICT_PORT=false

# IP_SALT: salt used when hashing visitor IPs for privacy-preserving analytics.
IP_SALT="change-me-to-a-random-string"

# Security: only enable when custom merchant domains have been independently verified.
MUIRO_ALLOW_CUSTOM_AFFILIATE_DOMAINS=false
# Set true only when deployed behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# Optional recovery key used only by the forgotten-PIN reset flow. Leave blank to require Authenticator TOTP only.
# MUIRO_MASTER_KEY=
