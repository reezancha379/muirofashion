# Local Express development. Use a private 6-12 digit PIN and keep .env out of Git.
MUIRO_ADMIN_PIN=
PORT=3000
HOST=0.0.0.0
STRICT_PORT=false

# Privacy salt for local analytics IP hashing.
IP_SALT="change-me-to-a-random-string"

# Local Express only. Production Edge/static publishing uses a fixed shared
# allowlist; update both validators and their tests before adding a new host.
MUIRO_ALLOW_CUSTOM_AFFILIATE_DOMAINS=false
# Set true only when local Express is behind a trusted reverse proxy.
TRUST_PROXY=false

# Optional private recovery value for local Express. Never prefix it with VITE_.
# MUIRO_MASTER_KEY=

# Public browser settings for a static Netlify build; safe to expose in the client.
# These identify the project only. Never put service-role/secret keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
